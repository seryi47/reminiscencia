# Python
__pycache__/
*.pyc
backend/.venv/
backend/*.egg-info/
.pytest_cache/

# Audio fuente sin licencia verificada o temporal: nunca se versiona (ADR-0007).
# El audio de reproducción de la biblioteca tampoco (ADR-0024): su fuente de verdad es el bucket privado de R2. Los
# jobs de los workflows lo generan en audio-library/audio/ de su copia de trabajo y 'publicar' lo sube al bucket. El
# audio que estuvo versionado sigue en el historial de git.
audio-library/audio/
audio-library/**/*.m4a
audio-library/**/*.mp3
audio-library/**/*.wav
audio-library/**/*.flac

# Base de datos local
*.sqlite
*.sqlite-journal

# Datos personales de pacientes: nunca en el repositorio
research-data/personal/
research-data/**/raw/

# Secretos
.env
.env.*
!.env.example

# Sistema
.DS_Store

# Web: no lleva audio (lo sirve R2, ADR-0020); los datos públicos de frontend/web/data sí se versionan (ADR-0007)

# Móvil: la app no lleva audio empaquetado; lee la biblioteca de la web (ADR-0004)
mobile/assets/audio/*
!mobile/assets/audio/.gitkeep

# APK y compilaciones: se publican como assets de GitHub Releases, nunca en Git (límite de 100 MiB)
# El resto de releases/ sí se versiona (READMEs, .gitkeep y la documentación de cada carpeta).
releases/**/*.apk
releases/**/SHA256SUMS.txt
mobile/build/

# Vercel: configuración local del proyecto enlazado
.vercel/

# Descargas temporales de la entrada por URL (ADR-0005)
audio-library/staging/

# Worktrees y estado de sesión de Claude Code (nunca se versionan)
.claude/
