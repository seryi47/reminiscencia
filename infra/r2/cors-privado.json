{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://reminiscencia.cometia.es",
          "https://reminiscencia.netlify.app",
          "https://reminiscencia.vercel.app",
          "http://localhost:4173",
          "http://localhost:5173",
          "http://127.0.0.1:4173",
          "http://127.0.0.1:5173"
