<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Ventana mientras arranca el proceso (Android 7 a 11; en 12+ manda values-v31): la pantalla de apertura de la
         app (drawable/launch_background.xml, ADR-0035). Se quita sola cuando Flutter pinta su primer fotograma. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Ventana detrás de Flutter mientras se inicia y durante toda la vida de la app. Del color de fondo de la app
         (no ?android:colorBackground, que en modo claro es blanco y daba un destello blanco al abrir; ADR-0035). -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>
</resources>
