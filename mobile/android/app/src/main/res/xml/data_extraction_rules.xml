<?xml version="1.0" encoding="utf-8"?>
<!-- Copia en la nube y traspaso entre dispositivos (API 31 y posteriores). Mismo criterio que backup_rules.xml:
     el audio subido desde este teléfono no sale del dispositivo; solo los metadatos. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_flutter/biblioteca-local/audio/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_flutter/biblioteca-local/audio/" />
    </device-transfer>
</data-extraction-rules>
