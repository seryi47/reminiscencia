<?xml version="1.0" encoding="utf-8"?>
<!-- Copia en la nube y traspaso entre dispositivos (API 31 y posteriores). Mismo criterio que backup_rules.xml:
     las canciones subidas desde este teléfono (audio y metadatos) no salen del dispositivo (ADR-0012 y ADR-0013),
     ni las portadas propias de las listas (listas-portadas). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_flutter/biblioteca-local/" />
        <exclude domain="root" path="app_flutter/listas-portadas/" />
        <exclude domain="file" path="registro/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_flutter/biblioteca-local/" />
        <exclude domain="root" path="app_flutter/listas-portadas/" />
        <exclude domain="file" path="registro/" />
    </device-transfer>
</data-extraction-rules>
